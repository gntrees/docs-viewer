{
  "name": "@gntrees/docs-viewer",
  "version": "0.0.1",
  "description": "Framework-agnostic document viewer as a Web Component (plain JS, React, Preact, Vue, Svelte, Solid).",
  "keywords": [
    "document-viewer",
    "file-viewer",
    "pdf",
    "office",
    "web-component",
    "custom-element",
    "react",
    "preact",
    "vue",
    "svelte",
    "solid",
    "shiki"
  ],
  "homepage": "https://gntrees.github.io/docs-viewer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gntrees/docs-viewer.git",
    "directory": "packages/docs-viewer"
  },
  "bugs": {
    "url": "https://github.com/gntrees/docs-viewer/issues"
  },
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "gntrees",
    "url": "https://github.com/gntrees"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/standalone.js"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./preact": {
      "types": "./dist/preact.d.ts",
      "import": "./dist/preact.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js"
    },
    "./standalone": {
      "types": "./dist/standalone.d.ts",
      "import": "./dist/standalone.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "prepack": "npm run build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "preact": ">=10.20",
    "react": ">=18",
    "react-dom": ">=18",
    "solid-js": ">=1.8",
    "svelte": ">=4",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^21.0.1",
    "preact": "^10.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^5.0.3",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@panzoom/panzoom": "^4.6.2",
    "brotli-dec-wasm": "^2.3.2",
    "hls.js": "^1.7.3",
    "marked": "^18.1.0",
    "node-unrar-js": "^2.0.2",
    "shiki": "^4.5.0"
  }
}

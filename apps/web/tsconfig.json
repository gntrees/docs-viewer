{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "types": ["vite/client"],
    "paths": {
      "@gntrees/docs-viewer": ["../../packages/docs-viewer/src/entry/index.ts"],
      "@gntrees/docs-viewer/*": ["../../packages/docs-viewer/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}

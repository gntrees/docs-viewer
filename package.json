{
  "name": "gntrees-docs-viewer",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "viewer:build": "bun run --filter @gntrees/docs-viewer build",
    "viewer:dev": "bun run --filter @gntrees/docs-viewer dev",
    "viewer:typecheck": "bun run --filter @gntrees/docs-viewer typecheck",
    "viewer:test": "bun run --filter @gntrees/docs-viewer test",
    "web:dev": "bun run --filter web dev",
    "web:build": "bun run --filter web build",
    "web:typecheck": "bun run --filter web typecheck",
    "web:preview": "bun run --filter web preview",
    "frameworks:dev": "bun run --filter frameworks dev",
    "frameworks:build": "bun run --filter frameworks build",
    "frameworks:typecheck": "bun run --filter frameworks typecheck",
    "frameworks:preview": "bun run --filter frameworks preview",
    "web:deploy": "sh apps/web/scripts/deploy-gh-pages.sh",
    "example:serve": "bunx --bun serve .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
